{
  "title": "Market Scan",
  "order": 1,
  "skills": [
    "market-scan"
  ],
  "blocks": [
    {
      "type": "run",
      "job": "scan",
      "label": "Run market scan"
    },
    {
      "type": "panel",
      "file": "ui/SymbolChart.tsx"
    },
    {
      "type": "panel",
      "file": "ui/Today.tsx"
    },
    {
      "type": "markdown",
      "data": "market.summary"
    },
    {
      "type": "metrics",
      "title": "Market",
      "data": "market.metrics"
    },
    {
      "type": "row",
      "blocks": [
        {
          "type": "alerts",
          "title": "Alerts",
          "data": "market.alerts"
        },
        {
          "type": "table",
          "title": "Sectors",
          "data": "market.sectors",
          "columns": [
            "sector",
            "change",
            "note"
          ]
        }
      ]
    },
    {
      "type": "heading",
      "text": "News on my holdings"
    },
    {
      "type": "markdown",
      "data": "market.holdingsNote"
    },
    {
      "type": "table",
      "title": "Holdings news",
      "data": "market.holdingsNews",
      "columns": [
        "ticker",
        "headline",
        "source",
        "time",
        "impact",
        "action"
      ]
    },
    {
      "type": "table",
      "title": "News",
      "data": "market.news",
      "columns": [
        "headline",
        "why",
        "source"
      ]
    },
    {
      "type": "table",
      "title": "Watch list",
      "data": "market.watch",
      "columns": [
        "ticker",
        "reason"
      ]
    },
    {
      "type": "report",
      "title": "Last report",
      "job": "scan"
    }
  ]
}
