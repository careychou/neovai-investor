{
  "name": "neovai-investor",
  "version": "0.7.0",
  "private": true,
  "description": "Neovai Investor: a daily stock-pick assistant that whose screens, jobs and skills change live through its Codify agent.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:kernel": "node scripts/check-kernel.mjs",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.0",
    "neovai-kernel": "file:../neovai-kernel",
    "recharts": "^3.11.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "dev.careychou.neovai-investor",
    "productName": "Neovai Investor",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "workspace",
        "to": "workspace"
      },
      {
        "from": "kernel.json",
        "to": "kernel.json"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "neovai-investor-${version}-${arch}.${ext}",
    "publish": null
  }
}
